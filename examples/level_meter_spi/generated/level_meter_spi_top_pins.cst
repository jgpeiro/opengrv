// level_meter_spi_top_pins.cst - pin constraint template generated by grvgen 0.3; fill in the IO_LOC values.
// Pull-ups on UART and SPI inputs (idle high lines); set IO_TYPE to the bank voltage of the board.

// adc: SPI master input, s12.11, 16-bit frames, mode 0, 200 kS/s
IO_LOC "adc_sclk" ?;
IO_PORT "adc_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "adc_cs_n" ?;
IO_PORT "adc_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "adc_mosi" ?;
IO_PORT "adc_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "adc_miso" ?;
IO_PORT "adc_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// led: GPIO output, u1.0, parallel
IO_LOC "led_out" ?;
IO_PORT "led_out" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// log: UART output, s16.14, 115200 Bd, text
IO_LOC "log_txd" ?;
IO_PORT "log_txd" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

