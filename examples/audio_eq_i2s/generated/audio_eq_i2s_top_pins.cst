IO_PORT "codec_in_ws" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "codec_in_sd" ?;
IO_PORT "codec_in_sd" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// codec_out: I2S master output, cs24.23, I2S, 24 of 32 bits, 48 kS/s
