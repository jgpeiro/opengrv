// siggen_spi_dac_top_pins.cst - pin constraint template generated by grvgen 0.3; fill in the IO_LOC values.
// Pull-ups on UART and SPI inputs (idle high lines); set IO_TYPE to the bank voltage of the board.

// dac: SPI master output, cs12.11, 16-bit frames, mode 0, 100 kS/s
IO_LOC "dac_sclk" ?;
IO_PORT "dac_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "dac_cs_n" ?;
IO_PORT "dac_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "dac_mosi" ?;
IO_PORT "dac_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// pwm: GPIO output, s8.7, PWM
IO_LOC "pwm_out" ?;
IO_PORT "pwm_out" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

