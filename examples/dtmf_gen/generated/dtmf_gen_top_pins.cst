// dtmf_gen_top_pins.cst - pin constraint template generated by grvgen 0.3; fill in the IO_LOC values.
// Pull-ups on UART and SPI inputs (idle high lines); set IO_TYPE to the bank voltage of the board.

// audio: I2S master output, s16.15, left-justified, 16 of 16 bits, mono left and right, 48 kS/s
IO_LOC "audio_bclk" ?;
IO_PORT "audio_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "audio_ws" ?;
IO_PORT "audio_ws" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "audio_sd" ?;
IO_PORT "audio_sd" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// pin: GPIO output, s12.11, sigma-delta, 48 kS/s
IO_LOC "pin_out" ?;
IO_PORT "pin_out" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

