// am_rx_i2s_top_pins.cst - pin constraint template generated by grvgen 0.3; fill in the IO_LOC values.
// Pull-ups on UART and SPI inputs (idle high lines); set IO_TYPE to the bank voltage of the board.

// audio: I2S master output, s16.15, I2S, 16 of 32 bits, mono left and right, 48 kS/s
IO_LOC "audio_bclk" ?;
IO_PORT "audio_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "audio_ws" ?;
IO_PORT "audio_ws" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "audio_sd" ?;
IO_PORT "audio_sd" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

