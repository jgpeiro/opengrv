// nbfm_rx_top_pins.cst - pin constraint template generated by grvgen 0.3; fill in the IO_LOC values.
// Pull-ups on UART and SPI inputs (idle high lines); set IO_TYPE to the bank voltage of the board.

// audio: GPIO output, s12.11, sigma-delta, 48 kS/s
IO_LOC "audio_out" ?;
IO_PORT "audio_out" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// log: UART output, s16.11, 115200 Bd, text
IO_LOC "log_txd" ?;
IO_PORT "log_txd" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

